        <mxCell id="vDpMT1KZrxu0gsrRI_nK-21" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=#36393d;fillColor=#f9f7ed;align=center;verticalAlign=middle;rounded=0;" value="&lt;font style=&quot;font-size: 15px;&quot;&gt;Ericsson&amp;nbsp; Cloud Execution Envirnment&lt;/font&gt;" vertex="1">
          <mxGeometry height="35" width="236" x="561" y="1755" as="geometry" />
