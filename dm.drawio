        <mxCell id="vDpMT1KZrxu0gsrRI_nK-20" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=#36393d;fillColor=#f9f7ed;align=center;verticalAlign=middle;rounded=0;" value="&lt;font style=&quot;font-size: 15px;&quot;&gt;CaaS&lt;/font&gt;" vertex="1">
